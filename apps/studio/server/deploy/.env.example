STUDIO_IMAGE=ghcr.io/tinkerfin-ai/studio-server:0.1.0
COMPOSE_PROFILES=bundled
STUDIO_BIND_ADDRESS=127.0.0.1
STUDIO_PORT=8090
DEPLOY_WAIT_TIMEOUT=600
PIP_INDEX_URL=https://pypi.org/simple

MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_DATABASE=tinkerfin
MYSQL_USER=studio
# 本机连接内置 MySQL 的端口；MYSQL_PORT 是后端连接数据库的端口
MYSQL_PUBLISHED_PORT=13306

DATABASE_ECHO=false

REDIS_CONTROL_HOST=redis-control
REDIS_CONTROL_PORT=6379
REDIS_CONTROL_PUBLISHED_PORT=6379
REDIS_CONTROL_DB=0
REDIS_CONTROL_RUN_KEY_PREFIX=tinkerfin:studio:run
REDIS_CONTROL_AUTH_KEY_PREFIX=tinkerfin:studio:auth

REDIS_RUNTIME_HOST=redis-runtime
REDIS_RUNTIME_PORT=6379
REDIS_RUNTIME_PUBLISHED_PORT=6380
REDIS_RUNTIME_DB=0
REDIS_RUNTIME_CHECKPOINT_DB=0
REDIS_RUNTIME_MESSAGING_KEY_PREFIX=tinkerfin:studio:messaging
REDIS_RUNTIME_CHECKPOINT_PREFIX=tinkerfin:studio:checkpoint
REDIS_RUNTIME_CHECKPOINT_WRITE_PREFIX=tinkerfin:studio:checkpoint_write

OPEN_SANDBOX_DOMAIN=opensandbox:8090
OPEN_SANDBOX_PUBLISHED_PORT=8091
OPEN_SANDBOX_PROTOCOL=http
OPEN_SANDBOX_WARM_POOL_SIZE=1
OPEN_SANDBOX_WORKSPACE_ROOT=/workspace
OPEN_SANDBOX_STATE_NAMESPACE=tinkerfin-studio

AUTH_TOKEN_EXPIRE_SECONDS=86400
MESSAGING_RETENTION_SECONDS=86400
TAVILY_API_KEY=
LANGSMITH_TRACING=false
LANGSMITH_PROJECT=tinkerfin-studio
LANGSMITH_API_KEY=

LOG_LEVEL=INFO
