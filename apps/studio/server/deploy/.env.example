STUDIO_BIND_ADDRESS=127.0.0.1
STUDIO_PORT=8090
DEPLOY_WAIT_TIMEOUT=180
PIP_INDEX_URL=https://pypi.org/simple

MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_DATABASE=tinkerfin
MYSQL_USER=studio

DATABASE_ECHO=false
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_RECYCLE=3600

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_CHECKPOINT_DB=0
REDIS_MAX_CONNECTIONS=80
REDIS_SOCKET_TIMEOUT_SECONDS=10
REDIS_MESSAGING_KEY_PREFIX=tinkerfin:studio:messaging
REDIS_RUN_KEY_PREFIX=tinkerfin:studio:run
REDIS_AUTH_KEY_PREFIX=tinkerfin:studio:auth
REDIS_CHECKPOINT_PREFIX=tinkerfin:studio:checkpoint
REDIS_CHECKPOINT_WRITE_PREFIX=tinkerfin:studio:checkpoint_write

OPEN_SANDBOX_DOMAIN=opensandbox:8090
OPEN_SANDBOX_PROTOCOL=http
OPEN_SANDBOX_WARM_POOL_SIZE=1
OPEN_SANDBOX_WORKSPACE_ROOT=/workspace
OPEN_SANDBOX_STATE_NAMESPACE=tinkerfin-studio

AUTH_TOKEN_EXPIRE_SECONDS=1800
TAVILY_API_KEY=
LANGSMITH_TRACING=false
LANGSMITH_PROJECT=tinkerfin-studio
LANGSMITH_API_KEY=

LOG_LEVEL=INFO
LOG_FILE_ENABLED=false
LOG_FILE_PATH=/app/logs/tinkerfin-studio.log
LOG_FILE_MAX_BYTES=5242880
LOG_FILE_BACKUP_COUNT=3
