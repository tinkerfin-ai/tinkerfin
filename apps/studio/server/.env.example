# MySQL 8.0，必须使用原生异步 asyncmy 驱动
DATABASE_URL=mysql+asyncmy://user:password@127.0.0.1:3306/tinkerfin?charset=utf8mb4
DATABASE_ECHO=false
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_RECYCLE=3600
DATABASE_CONNECTION_BUDGET=21
DATABASE_MANAGEMENT_CONNECTION_RESERVE=10

REDIS_CONTROL_HOST=127.0.0.1
REDIS_CONTROL_PORT=6379
REDIS_CONTROL_PASSWORD=
REDIS_CONTROL_DB=0
REDIS_CONTROL_MAX_CONNECTIONS=32
REDIS_CONTROL_SOCKET_TIMEOUT_SECONDS=10
REDIS_CONTROL_RUN_KEY_PREFIX=tinkerfin:studio:run
REDIS_CONTROL_AUTH_KEY_PREFIX=tinkerfin:studio:auth

REDIS_RUNTIME_HOST=127.0.0.1
REDIS_RUNTIME_PORT=6380
REDIS_RUNTIME_PASSWORD=
REDIS_RUNTIME_DB=0
REDIS_RUNTIME_CHECKPOINT_DB=0
REDIS_RUNTIME_MAX_CONNECTIONS=80
REDIS_RUNTIME_SOCKET_TIMEOUT_SECONDS=10
REDIS_RUNTIME_MESSAGING_KEY_PREFIX=tinkerfin:studio:messaging
REDIS_RUNTIME_CHECKPOINT_PREFIX=tinkerfin:studio:checkpoint
REDIS_RUNTIME_CHECKPOINT_WRITE_PREFIX=tinkerfin:studio:checkpoint_write

# OpenSandbox
OPEN_SANDBOX_DOMAIN=127.0.0.1:8091
OPEN_SANDBOX_PROTOCOL=http
OPEN_SANDBOX_API_KEY=
OPEN_SANDBOX_WARM_POOL_SIZE=1
OPEN_SANDBOX_WORKSPACE_ROOT=/workspace
OPEN_SANDBOX_STATE_NAMESPACE=tinkerfin-studio

# 认证和业务 Tool
AUTH_TOKEN_EXPIRE_SECONDS=86400
MESSAGING_RETENTION_SECONDS=86400
TAVILY_API_KEY=

# 可选 LangSmith tracing
LANGSMITH_TRACING=false
LANGSMITH_PROJECT=tinkerfin-studio
LANGSMITH_API_KEY=

# 附件持久化目录；模型和生图服务由用户在设置页配置
# 相对路径以此配置文件所在目录为基准；容器使用挂载卷的绝对路径
ATTACHMENT_DIRECTORY=.data/attachments

# 管理员允许的 HTTP、本机或内网模型服务，JSON 数组中只填写协议、主机和端口
# 例如 MODEL_ALLOWED_ORIGINS=["http://127.0.0.1:11434","http://localhost:11434"]
MODEL_ALLOWED_ORIGINS=[]
