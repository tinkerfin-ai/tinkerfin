flowchart TD
    A(["任务执行中"]) --> B{"变化来源"}

    B -->|"Guard 检测失效"| C["记录无效假设和失败证据"]
    C --> H["冻结当前 PlanRun 快照"]

    B -->|"用户新消息"| D{"控制意图分类"}

    D -->|"side_question"| E["只回答进度"]
    E --> A

    D -->|"stage_input"| F["加入当前 Stage 上下文"]
    F --> A

    D -->|"cancel_request"| X(["CANCELLED"])

    D -->|"change_request"| G["请求安全暂停"]
    G --> H

    H --> I["收集 completed stages、artifacts、evidence"]
    I --> J["Impact Analysis"]
    J --> K["生成 PlanDraft vNext"]
    K --> L{"ValidateDraft"}

    L -->|"无效"| K
    L -->|"有效"| M["Plan Review Interrupt"]

    M -->|"edit / respond"| K
    M -->|"reject"| Y(["PAUSED"])
    M -->|"approve"| N["激活 ConfirmedPlan vNext"]

    N --> O["复用有效进度并重新 Dispatch"]
    O --> A